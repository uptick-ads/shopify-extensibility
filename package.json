{
  "name": "@uptick-ads/shopify-extensibility",
  "version": "1.0.0",
  "description": "A Shopify Checkout UI Extensibility utility package that provides an interface to dynamically load and displays Uptick offers. Easily integrates into existing Shopify Checkout UI apps for seamless upsell and cross-sell experiences.",
  "scripts": {
    "lint": "npx eslint \"**/*.{js,jsx}\"",
    "lint:fix": "npx eslint --fix \"**/*.{js,jsx}\"",
    "test": "NODE_ENV=test jest",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "prepare": "if [ -d .git ]; then husky; else echo 'Not a git repo, skipping husky'; fi",
    "changelog": "npx git-cliff --unreleased -o CHANGES.md",
    "changelog:full": "npx git-cliff -o CHANGELOG.md",
    "version:next": "./bin/next_version.sh"
  },
  "author": "Uptick",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@preact/signals": "^2.3.0",
    "@shopify/ui-extensions": "~2026.7.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/preact": "^3.2.0",
    "babel-jest": "^30.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-jsx": "^5.18.6",
    "eslint-plugin-react-x": "^5.18.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "preact": "^10.10.0"
  }
}
